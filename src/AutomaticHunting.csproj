<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AutomaticHunting</AssemblyName>
    <RootNamespace>AutomaticHunting</RootNamespace>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>14.0</LangVersion>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(DALAMUD_LIB_PATH)/</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="AutomaticHunting.Help.help.json" />
    <None Remove="TraditionalNames.zh-TW.json" />
    <EmbeddedResource Include="TraditionalNames.zh-TW.json" WithCulture="false" LogicalName="AutomaticHunting.TraditionalNames.zh-TW.json" />
    <EmbeddedResource Include="AutomaticHunting.Help.help.json" LogicalName="AutomaticHunting.Help.help.json" />
    <PackageReference Include="ECommons" Version="3.2.1.22" />
    <Reference Include="Dalamud"><HintPath>$(DalamudLibPath)Dalamud.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FFXIVClientStructs"><HintPath>$(DalamudLibPath)FFXIVClientStructs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Lumina"><HintPath>$(DalamudLibPath)Lumina.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Lumina.Excel"><HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="InteropGenerator.Runtime"><HintPath>$(DalamudLibPath)InteropGenerator.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
